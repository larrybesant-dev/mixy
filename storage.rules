rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function metadataOwnerMatchesRequest() {
      return request.resource != null
        && request.resource.metadata != null
        && request.resource.metadata.ownerUid is string
        && request.resource.metadata.ownerUid == request.auth.uid;
    }

    function metadataOwnerMatchesExisting() {
      return resource != null
        && resource.metadata != null
        && resource.metadata.ownerUid is string
        && resource.metadata.ownerUid == request.auth.uid;
    }

    // 5MB limit for images. Strictly allow only common web formats.
    function isImageUpload() {
      return request.resource != null
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
        && request.resource.size < 5 * 1024 * 1024;
    }

    // 50MB limit for videos.
    function isVideoUpload() {
      return request.resource != null
        && request.resource.contentType.matches('video/(mp4|webm|quicktime)')
        && request.resource.size < 50 * 1024 * 1024;
    }

    // ---------------------------------------------------------------------
    // User Content
    // ---------------------------------------------------------------------

    match /users/{userId}/profile_photos/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && isImageUpload();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/cover_photos/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && isImageUpload();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/gallery_photos/{fileName} {
      // Gallery photos are visible to all authenticated users.
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && isImageUpload();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/intro_videos/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && isVideoUpload();
      allow delete: if isOwner(userId);
    }

    // ---------------------------------------------------------------------
    // Features (Stories, Posts)
    // ---------------------------------------------------------------------

    match /users/{userId}/stories/images/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && isImageUpload();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/stories/videos/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && isVideoUpload();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/posts/images/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && isImageUpload();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/posts/videos/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && isVideoUpload();
      allow delete: if isOwner(userId);
    }

    // ---------------------------------------------------------------------
    // Rooms
    // ---------------------------------------------------------------------

    match /rooms/{roomId}/{allPaths=**} {
      // Room content is readable by any signed-in user.
      allow read: if signedIn();
      // Room assets are owner-bound using immutable metadata ownerUid.
      // Upload clients must set SettableMetadata(customMetadata: {'ownerUid': uid}).
      allow create: if signedIn()
        && isImageUpload()
        && metadataOwnerMatchesRequest();
      allow update: if signedIn()
        && isImageUpload()
        && metadataOwnerMatchesExisting()
        && metadataOwnerMatchesRequest();
      allow delete: if signedIn() && metadataOwnerMatchesExisting();
    }

    // ---------------------------------------------------------------------
    // Default Deny
    // ---------------------------------------------------------------------

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
